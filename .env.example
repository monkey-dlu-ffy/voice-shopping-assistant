# Port the Express server listens on (Cloud Run injects this automatically)
PORT=8080

# MongoDB connection string.
# Local (docker compose): mongodb://mongo:27017/vsa
# Production: your MongoDB Atlas M0 connection string
MONGODB_URI=mongodb://mongo:27017/vsa

# Optional. The app works fully without this key - the rule-based parser
# handles every command it recognises, and unmatched phrasings return a
# friendly "I didn't catch that" instead of falling through to the LLM.
ANTHROPIC_API_KEY=

# Model used for the natural-language fallback parser.
ANTHROPIC_MODEL=claude-haiku-4-5
