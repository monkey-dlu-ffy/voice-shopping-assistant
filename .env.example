# Port the Express server listens on (most hosts inject this automatically)
PORT=8080

# MongoDB connection string.
# Local (docker compose): mongodb://mongo:27017/vsa
# Production: your MongoDB Atlas M0 connection string
MONGODB_URI=mongodb://mongo:27017/vsa

# Both LLM keys below are optional. The app works fully without either - the
# rule-based parser handles every command it recognises, and unmatched
# phrasings return a friendly "I didn't catch that" instead of falling through
# to a model. If both are set, Gemini is used.

# Preferred: genuinely free, no billing account required.
# Get a key at https://aistudio.google.com (sign in with a Google account -
# this is a different signup path from Google Cloud/Vertex, and does not ask
# for a card on the free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Alternative, if you already have Claude billing configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
